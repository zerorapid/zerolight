{
  "framework": "nextjs",
  "regions": ["sin1", "bom1"],
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://ui.zerorapid.in"
  },
  "headers": [
    {
      "source": "/r/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/registry/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
